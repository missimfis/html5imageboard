%h1= @board.title
.board-meta-bar
  .meta= "Created #{time_ago_in_words(@board.created_at)} ago"
  = link_to "‹ All Boards", boards_path, class: "back-link"

#posts
  = render partial: "posts/post", collection: @posts

!= @pagy.series_nav

.toggle-section{data: {controller: "toggle"}}
  %button#new_post_button.secondary{type: "button", data: {action: "click->toggle#toggle", toggle_target: "button", toggle_hidden_text_value: "＋ Add Post", toggle_shown_text_value: "Cancel"}} ＋ Add Post

  #new_post_form.hidden{data: {toggle_target: "content"}}
    %h2 New Post
    = render partial: "posts/form", locals: {post: @board.posts.build}