%h1 Boards
.toggle-section{data: {controller: "toggle"}}
  .board-actions-header
    %button#new_board_button.secondary{type: "button", data: {action: "click->toggle#toggle", toggle_target: "button", toggle_hidden_text_value: "＋ Add Board", toggle_shown_text_value: "Cancel"}} ＋ Add Board

  #new_board_form.hidden{data: {toggle_target: "content"}}
    %h2 New Board
    = render "form"

.board-list
  - @boards.each do |board|
    .board-item
      = link_to board, class: "board-link" do
        .board-info
          .board-title= board.title
          .board-meta= "created #{time_ago_in_words(board.created_at)} ago"
      .board-actions
        = link_to "✏️", edit_board_path(board), class: "board-action-icon", title: "Edit"
        = button_to "🗑️", board_path(board), method: :delete, class: "board-action-icon", title: "Delete", data: {confirm: "Delete this board?"}

!= @pagy.series_nav