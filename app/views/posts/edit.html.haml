- content_for(:title) { "Edit: #{@post.title}" }

%nav.breadcrumbs.mb-5.text-sm{class: "text-base-content/50", aria: {label: "Breadcrumb"}}
  %ul
    %li= link_to "Boards", boards_path, class: "link link-hover"
    %li= link_to @board.title, board_path(@board), class: "link link-hover"
    %li
      %span{aria: {current: "page"}} Edit drawing

%section.mb-8.space-y-4
  %span.eyebrow Edit drawing
  %h1.page-title= @post.title
  %p{class: "text-base-content/55"}= relative_time(@post.updated_at, prefix: "Last updated ")

.card.border.border-base-300.bg-base-200.shadow-lg
  .card-body.p-5.sm:p-7
    = render "form", post: @post
