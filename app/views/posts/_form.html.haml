= form_with(model: [@board, post], class: "space-y-6") do |f|
  = render "shared/errors", object: post

  .space-y-5
    %div
      = f.label :title, "Title", class: "mb-2 block text-sm font-semibold"
      = f.text_field :title, placeholder: "Give your drawing a name", maxlength: Post::TITLE_MAX_LENGTH, required: true, autocomplete: "off", autofocus: post.persisted?, class: "input input-bordered w-full"

    %div
      = f.label :description, "Description", class: "mb-2 block text-sm font-semibold"
      = f.text_area :description, placeholder: "Optional: add some context for your drawing", rows: 3, maxlength: Post::DESCRIPTION_MAX_LENGTH, class: "textarea textarea-bordered w-full"

  .space-y-3
    .flex.flex-wrap.items-center.justify-between.gap-2
      %span.text-sm.font-semibold Drawing
      %span.badge.badge-ghost.badge-sm 600 × 400 · PNG
    = render "posts/canvas", post: post

  .flex.flex-wrap.items-center.gap-3
    = f.submit post.persisted? ? "Save changes" : "Publish drawing", class: "btn btn-primary"
    - if post.persisted?
      = link_to "Cancel", board_path(@board), class: "btn btn-ghost"
    - else
      %button.btn.btn-ghost{type: "button", data: {action: "toggle#close"}} Cancel
